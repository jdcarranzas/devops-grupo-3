# Variables de entorno reales (contienen secretos). Solo se versiona .env.example
.env

# Archivos que la app de Claude descarga dentro del repositorio
Claude outputs/

# Archivos de sistema / editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Terraform ---
# Estado y planes: contienen los secretos en texto plano -> nunca se versionan
**/.terraform/*
*.tfstate
*.tfstate.*
terraform.tfstate.d/
*.tfplan
tfplan
tfplan.json
crash.log
crash.*.log
# Archivos locales con secretos (si alguien prefiere un .tfvars en vez de TF_VAR_)
*.secret.tfvars
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- GameDay y respaldos (Entregable 4) ---
# Valores de CPU guardados durante el escenario de saturación
gameday/.cpus-*.json
# Respaldos de la base de datos (contienen datos y hashes de contraseñas)
backups/
*.dump
