# Copie este archivo como .env y ajuste los valores:  cp .env.example .env
# NUNCA versione el archivo .env

# Con el despliegue de Terraform (Entregable 4) estas credenciales deben ser las
# MISMAS que TF_VAR_db_password y TF_VAR_keycloak_admin_password, porque las usan
# postgres-exporter y k6 para conectarse al sistema desplegado.

# --- PostgreSQL ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=cambiar_esta_clave

# --- Keycloak: administrador inicial (solo se usa en el primer arranque) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=cambiar_esta_clave_admin

# --- Observabilidad (observability/docker-compose.yml) ---
GRAFANA_ADMIN_PASSWORD=cambiar_esta_clave_admin_grafana
# Red backend a la que se une la observabilidad:
#   keycloak-prod-backend  -> despliegue de Terraform, ambiente prod (por defecto)
#   keycloak-dev-backend   -> despliegue de Terraform, ambiente dev
#   keycloak-devops_backend -> docker-compose.yml de la raíz (desarrollo rápido)
KC_BACKEND_NETWORK=keycloak-prod-backend
